# Cafe Bazaar RSA Public Key (Base64) from Cafe Bazaar Developer Console
# Required for cryptographic purchase verification.
# When empty or not configured, verification fails-closed (no purchases granted).
BAZAAR_PUBLIC_KEY=DEFAULT_BAZAAR_PUBLIC_KEY

# Tapsell Plus SDK Application Key
# Provided from Tapsell dashboard for rewarded video ads.
TAPSELL_KEY=DEFAULT_TAPSELL_KEY
